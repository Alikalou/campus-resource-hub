{
  "info": {
    "_postman_id": "17f24af1-2dc2-4e8f-baea-d032892fe940",
    "name": "Campus Resource Hub API",
    "description": "Postman collection for the Campus Resource Hub API.\n\nBefore running requests:\n1. Start the Express server.\n2. Select the `Campus Resource Hub - Local` environment.\n3. Run the Authentication requests in order: register member, login member, then login admin.\n\nMember and admin login automatically store `memberToken` and `adminToken`. Resource create/update requests require `adminToken`. Run the successful booking requests in order because booking creation stores `bookingId`, `bookingStartTime`, and `bookingEndTime` for later requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "POST Register Member",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Postman Member\",\n    \"email\": \"{{registeredUserEmail}}\",\n    \"password\": \"{{memberPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Creates a normal member. A pre-request script generates a unique email and stores it in `registeredUserEmail` so the request can be run repeatedly."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const uniqueEmail = `postman.member.${Date.now()}@example.com`;",
                  "pm.environment.set(\"registeredUserEmail\", uniqueEmail);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Registration succeeds\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.eql(true);",
                  "    pm.expect(body).to.have.property(\"data\");",
                  "});",
                  "",
                  "pm.test(\"Password hash is not exposed\", function () {",
                  "    const responseText = pm.response.text();",
                  "    pm.expect(responseText).not.to.include(\"password_hash\");",
                  "    pm.expect(responseText).not.to.include(\"passwordHash\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Login Member",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{registeredUserEmail}}\",\n    \"password\": \"{{memberPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Signs in the member created by the previous request. The test script stores the returned JWT in `memberToken`."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const token = body?.data?.token;",
                  "",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Login returns a token\", function () {",
                  "    pm.expect(body.success).to.eql(true);",
                  "    pm.expect(token).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "",
                  "if (token) {",
                  "    pm.environment.set(\"memberToken\", token);",
                  "}",
                  "",
                  "pm.test(\"Member token was stored\", function () {",
                  "    pm.expect(pm.environment.get(\"memberToken\")).to.eql(token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Login Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{adminEmail}}\",\n    \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Signs in the admin created by your seed or create-admin script. Set `adminEmail` and `adminPassword` in the environment first. The returned JWT is stored in `adminToken`."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get(\"adminEmail\") || !pm.environment.get(\"adminPassword\")) {",
                  "    throw new Error(\"Set adminEmail and adminPassword in the selected Postman environment.\");",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const token = body?.data?.token;",
                  "",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Admin login returns a token\", function () {",
                  "    pm.expect(body.success).to.eql(true);",
                  "    pm.expect(body.data).to.have.property(\"token\");",
                  "    pm.expect(token).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "",
                  "if (token) {",
                  "    pm.environment.set(\"adminToken\", token);",
                  "}",
                  "",
                  "pm.test(\"Admin token was stored\", function () {",
                  "    pm.expect(pm.environment.get(\"adminToken\")).to.eql(token);",
                  "});"
                ]
              }
            }
          ]
        }
      ],
      "description": "Run these requests in order. Registration generates a unique member email, member login stores `memberToken`, and admin login stores `adminToken`."
    },
