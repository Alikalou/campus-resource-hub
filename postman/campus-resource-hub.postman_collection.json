    {
      "name": "Bookings - Successful Requests",
      "item": [
        {
          "name": "01 - POST Create Booking - Member",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const start = new Date(Date.now() + 24 * 60 * 60 * 1000);",
                  "start.setUTCSeconds(0, 0);",
                  "const end = new Date(start.getTime() + 60 * 60 * 1000);",
                  "pm.environment.set(\"bookingStartTime\", start.toISOString());",
                  "pm.environment.set(\"bookingEndTime\", end.toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "const booking = body.data?.booking ?? body.data;",
                  "pm.test(\"Booking was created\", function () {",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(booking).to.have.property(\"id\");",
                  "  pm.expect(booking.status).to.eql(\"pending\");",
                  "});",
                  "if (booking?.id !== undefined) pm.environment.set(\"bookingId\", String(booking.id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{memberToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resource_id\": {{resourceId}},\n  \"start_time\": \"{{bookingStartTime}}\",\n  \"end_time\": \"{{bookingEndTime}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings"
              ]
            }
          },
          "response": []
        },
        {
          "name": "02 - GET My Bookings - Member",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const bookings = Array.isArray(body.data) ? body.data : body.data?.bookings;",
                  "pm.test(\"Member bookings are returned\", function () {",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(bookings).to.be.an(\"array\");",
                  "});",
                  "pm.test(\"Created booking is included\", function () {",
                  "  const id = pm.environment.get(\"bookingId\");",
                  "  pm.expect(bookings.some(b => String(b.id) === id)).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{memberToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/bookings/mine",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings",
                "mine"
              ]
            }
          },
          "response": []
