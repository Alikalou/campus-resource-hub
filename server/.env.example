# Express API
PORT=3000

# Node.js connection to PostgreSQL through Docker's published host port
DB_HOST=127.0.0.1
DB_PORT=5433
DB_URL=postgresql://campus_user:campus_password@127.0.0.1:5433/campus_resource_hub

# PostgreSQL container credentials
POSTGRES_USER=campus_user
POSTGRES_PASSWORD=campus_password
POSTGRES_DB=campus_resource_hub

# Json web token
JWT_SECRET=some_secret
JWT_EXPIRES_IN=1h